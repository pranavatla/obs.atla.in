    {
      "id": 21,
      "type": "stat",
      "title": "Blocked by firewall",
      "description": "Requests AWS WAF stopped before they reached the site, answered with 403. This is the firewall working, not the site failing. Measured \u00b7 CloudWatch AWS/WAFV2 (us-east-1) \u00b7 web ACL ${waf_acl}",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "refId": "A",
          "hide": false,
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "us-east-1",
          "namespace": "AWS/WAFV2",
          "metricName": "BlockedRequests",
          "statistic": "Sum",
          "dimensions": {
            "WebACL": "${waf_acl}",
            "Rule": "ALL"
          },
          "matchExact": true,
          "period": "3600",
          "id": "",
          "expression": "",
