        "hide": 2
      },
      {
        "name": "region",
        "label": "Region",
        "type": "constant",
        "query": "ap-south-1",
        "hide": 2
      },
      {
        "name": "bedrock_region",
        "label": "Bedrock region",
        "type": "constant",
        "query": "ap-south-1",
        "hide": 2
      },
      {
        "name": "price_llm_in",
