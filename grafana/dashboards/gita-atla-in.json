    {
      "type": "stat",
      "title": "Estimated Bedrock cost",
      "description": "Tokens × the per-1K-token prices entered in the dashboard's price boxes (top of the page), prefilled from the AWS Price List for ap-south-1 (on-demand, 2026-09-26). An estimate: check AWS Billing for the actual charge. Measured · CloudWatch AWS/Bedrock (${bedrock_region}) · calls made by the app.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "refId": "A",
          "hide": false,
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "${bedrock_region}",
          "expression": "FILL(SUM(SEARCH('{AWS/Bedrock,ModelId} MetricName=\"InputTokenCount\" ModelId=\"global.amazon.nova-2-lite-v1:0\"', 'Sum', 3600)), 0) / 1000 * ${price_llm_in} + FILL(SUM(SEARCH('{AWS/Bedrock,ModelId} MetricName=\"OutputTokenCount\" ModelId=\"global.amazon.nova-2-lite-v1:0\"', 'Sum', 3600)), 0) / 1000 * ${price_llm_out} + FILL(SUM(SEARCH('{AWS/Bedrock,ModelId} MetricName=\"InputTokenCount\" ModelId=\"amazon.titan-embed-text-v2:0\"', 'Sum', 3600)), 0) / 1000 * ${price_embed_in}",
          "id": "",
          "period": "300",
          "label": "Estimated cost"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "displayName": "Estimated Bedrock cost",
